# Copy to .env and fill only the services you are authorized to use.
WRDS_USERNAME=
PGPASSFILE=
ALPHAMAXX_HOST=127.0.0.1
ALPHAMAXX_PORT=8000
ALPHAMAXX_ALLOWED_HOSTS=127.0.0.1,localhost,::1
ALPHAMAXX_LIVE_RELOAD=0

# State defaults to a private per-user application-data directory. Override
# only with an absolute location that is not inside a Git repository.
# ALPHAMAXX_STATE_DIR=/absolute/private/path
# ALPHAMAXX_DB=/absolute/private/path/alphamaxx.db

# Optional external services. Leave blank for local-only behavior.
ALPHAMAXX_FMP_API_KEY=
ALPHAMAXX_AI_ENGINE=gemini
ALPHAMAXX_GEMINI_API_KEY=
ALPHAMAXX_ANTHROPIC_API_KEY=
ALPHAMAXX_OPENAI_API_KEY=
